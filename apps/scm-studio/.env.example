# SCM Studio · Umgebungsvariablen
# Lokal: in .env.local kopieren. Auf Vercel: im NEUEN Projekt (nicht MyImmo!) unter Settings → Environment Variables.
# Ohne die optionalen Werte läuft die App im Vorschau-/Demo-Modus.

# ── Basis ──────────────────────────────────────────────────────────────
# Öffentliche Adresse der App (für OAuth-Rückleitungen, iCal-Links, E-Mail-Links)
APP_URL=https://studio.scm-creatives.de
# Zufälliger Wert (openssl rand -base64 48) für Sitzungen im Vorschau-Modus
SESSION_SECRET=
# 32 Byte, base64 (openssl rand -base64 32): verschlüsselt Google-/Instagram-Tokens in der Datenbank
TOKEN_ENC_KEY=
# Vercel Cron schickt "Authorization: Bearer <CRON_SECRET>" (openssl rand -hex 32)
CRON_SECRET=

# Vorschau-Login (nur solange Supabase Auth NICHT eingerichtet ist; in Produktion Pflicht, sonst kein Login)
STUDIO_PREVIEW_PASSWORD=

# ── Datenbank (Supabase Postgres) ─────────────────────────────────────
# Leer = lokale Vorschau-Datenbank (PGlite in .data/)
# App: Transaction Pooler, Port 6543
DATABASE_URL=
# Migrationen (npm run db:migrate): Session Pooler oder Direktverbindung, Port 5432
MIGRATION_DATABASE_URL=
DB_POOL_MAX=3

# ── Supabase Auth + Storage ───────────────────────────────────────────
# Sind URL + Publishable Key gesetzt, gilt die Anmeldung mit E-Mail, Passwort und Zwei-Faktor-Code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Nur serverseitig (Einladungen, privater Storage). Niemals mit NEXT_PUBLIC_ beginnen lassen.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=studio

# ── KI-Skripte (OpenAI) ───────────────────────────────────────────────
# Ohne Schlüssel: Demo-Generator. Modell und Stufe in der App unter Einstellungen → KI.
OPENAI_API_KEY=
# Optional, z. B. EU-Datenresidenz nach Freigabe durch OpenAI: https://eu.api.openai.com/v1
OPENAI_BASE_URL=

# ── Google Kalender ───────────────────────────────────────────────────
# OAuth-Client (Typ Webanwendung). Weiterleitungs-URI: APP_URL + /api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Instagram (Instagram API with Instagram Login) ────────────────────
# Weiterleitungs-URI: APP_URL + /api/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ── TikTok (später) ───────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Website-Anfragen ──────────────────────────────────────────────────
# Gleicher Wert in der Website (Vercel-Projekt scm-creatives) als STUDIO_LEADS_SECRET.
# Lokal gilt ohne Wert "scm-studio-lokal", in Produktion ist er Pflicht. Ablauf: docs/website-anbindung.md
LEADS_WEBHOOK_SECRET=

# ── E-Mail (später, z. B. Rechnungsversand) ───────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
