# Inhalte der Redaktion: nur die beiden Inhaltsdateien sind öffentlich lesbar, alles andere bleibt zu.
Options -Indexes

# Noch nichts gespeichert? Dann die Grundfassung ausliefern statt 404 (saubere Browser-Konsole)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteOptions Inherit
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^inhalte\.json$ inhalte.standard.json [L]
</IfModule>

<IfModule mod_authz_core.c>
  Require all denied
  <FilesMatch "^inhalte(\.standard)?\.json$">
    Require all granted
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
  <FilesMatch "^inhalte(\.standard)?\.json$">
    Order deny,allow
    Allow from all
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache"
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
</IfModule>
